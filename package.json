{
  "name": "travu-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1",
    "start:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear -Tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:living-area": "node --experimental-strip-types ./scripts/test-living-areas.mjs",
    "test:home-region": "node --experimental-strip-types ./scripts/test-home-region-filter.mjs",
    "test:my-page-trips": "node --experimental-strip-types ./scripts/test-my-page-trips.mjs",
    "test:place-search": "node --experimental-strip-types --experimental-loader ./scripts/typescript-test-loader.mjs ./scripts/test-place-search.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "country-flag-icons": "^1.6.20",
    "expo": "^55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-media-library": "~55.0.21",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "i18n-iso-countries": "^7.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
