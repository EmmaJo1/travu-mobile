{
  "name": "travu-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1",
    "start:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear -Tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:living-area": "node --experimental-strip-types ./scripts/test-living-areas.mjs",
    "test:home-region": "node --experimental-strip-types ./scripts/test-home-region-filter.mjs",
    "test:my-page-trips": "node --experimental-strip-types ./scripts/test-my-page-trips.mjs",
    "test:place-search": "node --experimental-strip-types --experimental-loader ./scripts/typescript-test-loader.mjs ./scripts/test-place-search.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "country-flag-icons": "^1.6.20",
    "expo": "~57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18n-iso-countries": "^7.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
